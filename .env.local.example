# Local Windows/macOS/Linux development. Copy to .env.local in the project root.
TEST_SQLITE=1
COOKIE_SECURE=0
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Replace with output of: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=local-development-only-replace-with-your-generated-secret
